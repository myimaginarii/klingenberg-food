# dependencies
/node_modules

# next.js
/.next
/out
next-env.d.ts

# the static site's photographs — rendered by `scripts/images/build-static-derivatives.mjs`
# from the tracked sources in content/launch/photos/ on every build (prebuild), never
# committed: the sources and content/site/photos.json are the record.
/public/media

# production
/build

# testing
/coverage
/test-results
/playwright-report
/.playwright-mcp

# operator-supplied source material — an input folder, not a runtime asset location.
# What belongs in the repository (the logo, the confirmed photographs) is copied into
# public/ or content/launch/photos/ by hand; this directory is never read by the build.
/launch-assets

# local env — never commit an environment file.
#
# The static site needs no secret of any kind (see .env.example); `SITE_URL` is the one
# variable, it is optional, and it is set by whatever builds the site rather than stored
# here. This stays as a blanket rule anyway: a repository that has never held a
# credential is one nobody has to audit.
.env
.env.*
!.env.example

# editor / os
.DS_Store
Thumbs.db
*.swp
.idea
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo

# NOTE: package-lock.json is intentionally NOT ignored — CI runs `npm ci`.
