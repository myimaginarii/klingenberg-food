.DS_Store
Thumbs.db
*.swp
.idea
.vscode/*
!.vscode/extensions.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# NOTE: package-lock.json is intentionally NOT ignored — CI runs `npm ci`.
