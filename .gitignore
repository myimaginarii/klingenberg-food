/.next
/out
next-env.d.ts

# the static site's photographs — rendered by `scripts/images/build-static-derivatives.mjs`
# from the tracked sources in content/launch/photos/ on every build (prebuild), never
# committed: the sources and content/site/photos.json are the record.
/public/media

# production
/build

# testing
/coverage
/test-results
/playwright-report
/.playwright-mcp

# operator-supplied launch source material (phase 14B2) — an input folder, not a
# runtime asset location. What belongs in the repository (the logo, a licensed map)
# is copied into public/ or app/ by hand; this directory itself is never read by the
# application and never ships.
/launch-assets

# local env — never commit secrets. Names only live in .env.example.
#
# `.env.*` already covers every private environment file this repository uses, and
# the two that exist are deliberately separate (see .env.example):
#
#   .env.local             the LOCAL Supabase stack — development, the drills, the
#                          integration and E2E suites
#   .env.operator.local    the PRODUCTION project — `npm run launch:*`,
#                          `npm run backup:production`, `npm run backup:restore:production`
#
# Neither is ever committed, and no command loads both: a shell that can reach the
# local stack must not also be holding production credentials.
#
# The production file is deliberately NOT `.env.production.local`: Next.js loads
# that name itself during `next build` and `next start`, ahead of `.env.local`, so
# a plain local build would target production. `.env.operator.local` is a name
# Next never reads; only the explicit `--env-file-if-exists` commands do.
.env
.env.*
!.env.example

# supabase local
/supabase/.branches
/supabase/.temp
/supabase/.env

