# Klingenberg Food — environment variables (technical plan §10e)
#
# NAMES ONLY. This file is committed; it must never contain a real value.
# Copy it to `.env.local` (git-ignored) and fill it in locally.
#
# Real values live in:
#   - Vercel project settings              (application runtime)
#   - Supabase project settings            (auth SMTP)
#   - protected GitHub environments        (CI, and the phase-13 backup job)
#
# Local Supabase values are printed by `npm run db:start` and are throwaway keys
# for a container on this machine — they are still not committed.

# --- Supabase -----------------------------------------------------------------
# Public by design. The anon key is read-only via RLS (§8).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefixed NEXT_PUBLIC_. Read exclusively through
# lib/env/server.ts, which imports "server-only" (§8).
SUPABASE_SERVICE_ROLE_KEY=

# CI only, one per environment. Used for migrations. Always passed as an
# environment variable, never as a command-line argument (§8 — log hygiene).
SUPABASE_DB_URL=

# --- Site ---------------------------------------------------------------------
# The ONLY place a site domain may be configured. Everything absolute — canonicals,
# sitemap, robots, Open Graph, JSON-LD, Server Action allowed origins — resolves
# through lib/config/site.ts (§10d).
#
# Leave empty locally: it falls back to http://localhost:3000.
# Leave empty on Vercel until the domain exists: it falls back to the Vercel host.
SITE_URL=

# --- Monitoring (phase 13) ----------------------------------------------------
# Server-side Sentry only. There is deliberately no browser SDK (§1, §12).
SENTRY_DSN=

# --- CI (from phase 3, once Playwright runs against protected previews) -------
# Vercel Pro enables Deployment Protection on previews; E2E needs this to reach them.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Not set here -------------------------------------------------------------
# RESEND_API_KEY and AUTH_EMAIL_FROM are configured in Supabase project settings
# (custom SMTP), not in the application environment. Local development uses the
# Supabase CLI mail catcher instead (§10c).
#
# BACKUP_S3_* and SUPABASE_STORAGE_S3_* belong to the protected `backup` GitHub
# environment and arrive with the phase-13 backup workflow (§10f).
