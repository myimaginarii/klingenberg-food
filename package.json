{
  "name": "klingenberg-food",
  "version": "0.0.0",
  "private": true,
  "description": "Klingenberg Food, Carl Nielsen Hallen — the restaurant's website, a static Next.js export.",
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "scripts": {
    "predev": "npm run images:static",
    "dev": "next dev",
    "prebuild": "npm run images:static",
    "build": "next build",
    "postbuild": "node scripts/flatten-segment-cache.mjs",
    "images:static": "node scripts/images/build-static-derivatives.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "check:policy": "node scripts/check-source-policy.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:policy && npm run test",
    "check:all": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
