{
  "name": "klingenberg-food",
  "version": "0.0.0",
  "private": true,
  "description": "Klingenberg Food, Carl Nielsen Hallen — website and administration.",
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "check:policy": "node scripts/check-source-policy.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:policy && npm run test",
    "check:all": "npm run check && npm run build && npm run test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:cache:clear",
    "db:cache:clear": "node scripts/clear-data-cache.mjs",
    "db:reset:full": "npm run db:reset && npm run db:users",
    "db:users": "node --env-file-if-exists=.env.local scripts/seed-local-users.mjs",
    "db:test": "supabase test db",
    "db:status": "supabase status",
    "backup": "node --env-file-if-exists=.env.local scripts/backup/backup.mjs",
    "backup:restore": "node --env-file-if-exists=.env.local scripts/backup/restore.mjs",
    "backup:production": "node --env-file-if-exists=.env.production.local scripts/backup/backup.mjs",
    "backup:restore:production": "node --env-file-if-exists=.env.production.local scripts/backup/restore.mjs",
    "backup:drill": "vitest run --config vitest.backup.mts",
    "launch:migrate": "node --env-file-if-exists=.env.production.local scripts/launch/migrate.mjs",
    "launch:load-content": "node --env-file-if-exists=.env.production.local scripts/launch/load-content.mjs",
    "launch:bootstrap-owner": "node --env-file-if-exists=.env.production.local scripts/launch/bootstrap-owner.mjs",
    "launch:drill": "vitest run --config vitest.launch.mts"
  },
  "dependencies": {
    "@sentry/nextjs": "10.73.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
